generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserSystemRole {
  EMPLOYEE
  ADMIN
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  REVIEWER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  READY_FOR_REVIEW
  ACCEPTED
  CLOSED
}

enum TaskPriority {
  P0
  P1
  P2
  P3
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_HUMAN
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentToolCallStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum HumanConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArtifactType {
  FILE
}

enum ArtifactStorageKind {
  LOCAL_WORKSPACE
}

model User {
  id             String          @id @map("user_id")
  name           String
  systemRole     UserSystemRole  @map("system_role")
  departmentId   String?         @map("department_id")
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(3)
  projectMembers ProjectMember[]
  agentRuns      AgentRun[]

  @@map("users")
}

model Project {
  id        String          @id @map("project_id")
  name      String
  goal      String?
  status    ProjectStatus
  createdAt DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @map("updated_at") @db.Timestamptz(3)
  members   ProjectMember[]
  tasks     Task[]
  agentRuns AgentRun[]
  artifacts Artifact[]

  @@map("projects")
}

model ProjectMember {
  id              String            @id @map("project_member_id")
  projectId       String            @map("project_id")
  userId          String            @map("user_id")
  role            ProjectMemberRole
  createdAt       DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @map("updated_at") @db.Timestamptz(3)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  taskAssignments TaskAssignment[]

  @@unique([projectId, userId], map: "project_members_project_id_user_id_key")
  @@map("project_members")
}

model Task {
  id                 String           @id @map("task_id")
  projectId          String           @map("project_id")
  title              String
  description        String?
  priority           TaskPriority
  status             TaskStatus
  acceptanceCriteria String[]         @map("acceptance_criteria")
  deadline           DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @map("updated_at") @db.Timestamptz(3)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignment         TaskAssignment?
  dependencies       TaskDependency[] @relation("TaskDependencies")
  dependents         TaskDependency[] @relation("TaskDependents")
  agentRuns          AgentRun[]
  artifacts          Artifact[]

  @@unique([id, projectId], map: "tasks_task_id_project_id_key")
  @@map("tasks")
}

model AgentRun {
  id                 String         @id @map("agent_run_id")
  userId             String         @map("user_id")
  projectId          String         @map("project_id")
  taskId             String         @map("task_id")
  agentDefinitionKey String         @map("agent_definition_key")
  intent             Json
  status             AgentRunStatus
  createdAt          DateTime       @map("created_at") @db.Timestamptz(3)
  startedAt          DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?      @map("finished_at") @db.Timestamptz(3)
  updatedAt          DateTime       @map("updated_at") @db.Timestamptz(3)
  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task               Task           @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  toolCalls          AgentToolCall[]
  artifacts          Artifact[] @relation("ArtifactRun")
  confirmations      HumanConfirmation[]

  @@unique([id, userId, projectId, taskId], map: "agent_runs_agent_run_id_user_id_project_id_task_id_key")
  @@map("agent_runs")
}

model AgentToolCall {
  id          String              @id @map("agent_tool_call_id")
  agentRunId  String              @map("agent_run_id")
  sequence    Int
  name        String
  deviceId    String?             @map("device_id")
  request     Json
  status      AgentToolCallStatus
  receipt     Json?
  createdAt   DateTime            @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?           @map("completed_at") @db.Timestamptz(3)
  agentRun    AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]          @relation("ArtifactSourceToolCall")
  confirmation HumanConfirmation?

  @@unique([id, agentRunId], map: "agent_tool_calls_agent_tool_call_id_agent_run_id_key")
  @@unique([id, agentRunId, deviceId], map: "agent_tool_calls_agent_tool_call_id_agent_run_id_device_id_key")
  @@unique([agentRunId, sequence], map: "agent_tool_calls_agent_run_id_sequence_key")
  @@map("agent_tool_calls")
}

model HumanConfirmation {
  id          String                  @id @map("human_confirmation_id")
  agentRunId  String                  @map("agent_run_id")
  toolCallId  String                  @unique @map("tool_call_id")
  userId      String                  @map("user_id")
  projectId   String                  @map("project_id")
  taskId      String                  @map("task_id")
  deviceId    String                  @map("device_id")
  status      HumanConfirmationStatus
  createdAt   DateTime                @map("created_at") @db.Timestamptz(3)
  decidedAt   DateTime?               @map("decided_at") @db.Timestamptz(3)
  agentRun    AgentRun                @relation(fields: [agentRunId, userId, projectId, taskId], references: [id, userId, projectId, taskId], onDelete: Restrict)
  toolCall    AgentToolCall           @relation(fields: [toolCallId, agentRunId, deviceId], references: [id, agentRunId, deviceId], onDelete: Restrict)

  @@unique([toolCallId, agentRunId, deviceId], map: "human_confirmations_tool_call_id_agent_run_id_device_id_key")
  @@map("human_confirmations")
}

model Artifact {
  id               String              @id @map("artifact_id")
  projectId        String              @map("project_id")
  taskId           String              @map("task_id")
  agentRunId       String              @map("agent_run_id")
  sourceToolCallId String              @unique(map: "artifacts_source_tool_call_id_key") @map("source_tool_call_id")
  type             ArtifactType
  storageKind      ArtifactStorageKind @map("storage_kind")
  relativePath     String              @map("relative_path")
  size             Int
  encoding         String
  sha256           String
  version          Int
  createdByUserId  String              @map("created_by_user_id")
  createdAt        DateTime            @map("created_at") @db.Timestamptz(3)
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task             Task                @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  agentRun         AgentRun            @relation("ArtifactRun", fields: [agentRunId, createdByUserId, projectId, taskId], references: [id, userId, projectId, taskId], onDelete: Restrict)
  sourceToolCall   AgentToolCall       @relation("ArtifactSourceToolCall", fields: [sourceToolCallId, agentRunId], references: [id, agentRunId], onDelete: Restrict)

  @@map("artifacts")
}

model TaskAssignment {
  taskId        String        @id @map("task_id")
  projectId     String        @map("project_id")
  userId        String        @map("user_id")
  task          Task          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  projectMember ProjectMember @relation(fields: [projectId, userId], references: [projectId, userId], onDelete: Restrict)

  @@unique([taskId, projectId], map: "task_assignments_task_id_project_id_key")
  @@map("task_assignments")
}

model TaskDependency {
  taskId          String @map("task_id")
  dependsOnTaskId String @map("depends_on_task_id")
  task            Task   @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask   Task   @relation("TaskDependents", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}
