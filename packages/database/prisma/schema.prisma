generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserSystemRole {
  EMPLOYEE
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}
enum AuditSource {
  ADMIN_API
  SYSTEM
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}
enum OrganizationMembershipRole {
  OWNER
  ADMIN
  MEMBER
}
enum OrganizationMembershipStatus {
  ACTIVE
  DISABLED
}
enum DepartmentStatus {
  ACTIVE
  DISABLED
}
enum DepartmentMembershipRole {
  MANAGER
  MEMBER
}
enum DepartmentMembershipStatus {
  ACTIVE
  DISABLED
}
enum PermissionScopeType {
  ORGANIZATION
  DEPARTMENT
}
enum PermissionResource {
  ORGANIZATION
  DEPARTMENT
  PERMISSION
  RESULT
  AGENT
}
enum PermissionAction {
  VIEW
  MANAGE
  ASSIGN
  REVIEW
  EXECUTE
}
enum AgentDefinitionStatus {
  ACTIVE
  DISABLED
}
enum AgentVersionStatus {
  ACTIVE
  DISABLED
}
enum AgentRuntimeProfile {
  READ_ONLY_WORK
  CONFIRMED_WRITE_WORK
}
enum AgentAssignmentScopeType {
  ORGANIZATION
  DEPARTMENT
  USER
}
enum AgentAssignmentStatus {
  ACTIVE
  DISABLED
}
enum PermissionEffect {
  ALLOW
  DENY
}

enum ProjectMemberRole {
  OWNER
  MEMBER
  REVIEWER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  READY_FOR_REVIEW
  ACCEPTED
  CLOSED
}

enum TaskPriority {
  P0
  P1
  P2
  P3
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_HUMAN
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AgentRunKind {
  TOOL
  MODEL
}

enum ModelInvocationStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AgentToolCallStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum HumanConfirmationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArtifactType {
  FILE
}

enum ArtifactStorageKind {
  LOCAL_WORKSPACE
}

enum ResultStatus {
  DRAFT
  CANDIDATE
  HUMAN_REVIEW
  ACCEPTED
  REWORK
}

enum ReviewDecision {
  ACCEPT
  REWORK
}

model User {
  id             String          @id @map("user_id")
  name           String
  systemRole     UserSystemRole  @map("system_role")
  createdAt      DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @map("updated_at") @db.Timestamptz(3)
  projectMembers ProjectMember[]
  agentRuns      AgentRun[]
  modelInvocations ModelInvocation[]
  createdResults Result[] @relation("ResultCreator")
  submittedResults Result[] @relation("ResultSubmitter")
  reviews        Review[]
  account        Account?
  auditEvents AuditEvent[]
  organizationMembership OrganizationMembership?

  @@map("users")
}

model Organization {
  id String @id @map("organization_id")
  name String
  status OrganizationStatus
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  memberships OrganizationMembership[]
  departments Department[]
  agentDefinitions AgentDefinition[]
  auditEvents AuditEvent[]
  @@map("organizations")
}

model OrganizationMembership {
  id String @id @map("organization_membership_id")
  organizationId String @map("organization_id")
  userId String @unique(map: "organization_memberships_user_id_key") @map("user_id")
  role OrganizationMembershipRole
  status OrganizationMembershipStatus
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  departmentMembership DepartmentMembership?
  permissionOverrides PermissionOverride[]
  @@unique([organizationId, userId], map: "organization_memberships_organization_id_user_id_key")
  @@map("organization_memberships")
}

model PermissionOverride {
  id String @id @map("permission_override_id")
  organizationId String @map("organization_id")
  userId String @map("user_id")
  scopeType PermissionScopeType @map("scope_type")
  scopeId String @map("scope_id")
  resource PermissionResource
  action PermissionAction
  effect PermissionEffect
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  organizationMembership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  @@unique([organizationId, userId, scopeType, scopeId, resource, action], map: "permission_overrides_tuple_key")
  @@map("permission_overrides")
}

model Department {
  id String @id @map("department_id")
  organizationId String @map("organization_id")
  name String
  status DepartmentStatus
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships DepartmentMembership[]
  @@unique([organizationId, name], map: "departments_organization_id_name_key")
  @@unique([id, organizationId], map: "departments_department_id_organization_id_key")
  @@map("departments")
}

model DepartmentMembership {
  id String @id @map("department_membership_id")
  organizationId String @map("organization_id")
  departmentId String @map("department_id")
  userId String @unique(map: "department_memberships_user_id_key") @map("user_id")
  role DepartmentMembershipRole
  status DepartmentMembershipStatus
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  organizationMembership OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Restrict)
  department Department @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([organizationId, userId], map: "department_memberships_organization_id_user_id_key")
  @@map("department_memberships")
}

model Account {
  id           String        @id @map("account_id")
  userId       String        @unique(map: "accounts_user_id_key") @map("user_id")
  login        String        @unique(map: "accounts_login_key")
  passwordHash String        @map("password_hash")
  status       AccountStatus
  createdAt    DateTime      @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions     Session[]

  @@map("accounts")
}

model AuditEvent {
  id String @id @map("audit_event_id")
  organizationId String @map("organization_id")
  actorUserId String @map("actor_user_id")
  action String
  subjectType String @map("subject_type")
  subjectId String? @map("subject_id")
  resourceType String @map("resource_type")
  resourceId String? @map("resource_id")
  before Json?
  after Json?
  reason String?
  source AuditSource
  requestId String? @map("request_id")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields:[organizationId], references:[id], onDelete:Restrict)
  actor User @relation(fields:[actorUserId], references:[id], onDelete:Restrict)
  @@index([organizationId, createdAt, id], map:"audit_events_organization_created_id_idx")
  @@index([action, createdAt], map:"audit_events_action_created_idx")
  @@index([subjectType, subjectId], map:"audit_events_subject_idx")
  @@map("audit_events")
}

model Session {
  id        String   @id @map("session_id")
  accountId String   @map("account_id")
  tokenHash String   @unique(map: "sessions_token_hash_key") @db.Char(64) @map("token_hash")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, expiresAt], map: "sessions_account_id_expires_at_idx")
  @@map("sessions")
}

model Project {
  id        String          @id @map("project_id")
  name      String
  goal      String?
  status    ProjectStatus
  createdAt DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @map("updated_at") @db.Timestamptz(3)
  members   ProjectMember[]
  tasks     Task[]
  agentRuns AgentRun[]
  artifacts Artifact[]
  results   Result[]
  reviews   Review[]

  @@map("projects")
}

model ProjectMember {
  id              String            @id @map("project_member_id")
  projectId       String            @map("project_id")
  userId          String            @map("user_id")
  role            ProjectMemberRole
  createdAt       DateTime          @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @map("updated_at") @db.Timestamptz(3)
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user            User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  taskAssignments TaskAssignment[]

  @@unique([projectId, userId], map: "project_members_project_id_user_id_key")
  @@map("project_members")
}

model Task {
  id                 String           @id @map("task_id")
  projectId          String           @map("project_id")
  title              String
  description        String?
  priority           TaskPriority
  status             TaskStatus
  acceptanceCriteria String[]         @map("acceptance_criteria")
  deadline           DateTime?        @db.Timestamptz(3)
  createdAt          DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @map("updated_at") @db.Timestamptz(3)
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignment         TaskAssignment?
  dependencies       TaskDependency[] @relation("TaskDependencies")
  dependents         TaskDependency[] @relation("TaskDependents")
  agentRuns          AgentRun[]
  artifacts          Artifact[]
  results            Result[]

  @@unique([id, projectId], map: "tasks_task_id_project_id_key")
  @@map("tasks")
}

model AgentRun {
  id                 String         @id @map("agent_run_id")
  userId             String         @map("user_id")
  projectId          String         @map("project_id")
  taskId             String         @map("task_id")
  agentDefinitionKey String         @map("agent_definition_key")
  agentVersion       Int            @default(1) @map("agent_version")
  intent             Json
  kind               AgentRunKind  @default(TOOL)
  status             AgentRunStatus
  createdAt          DateTime       @map("created_at") @db.Timestamptz(3)
  startedAt          DateTime?      @map("started_at") @db.Timestamptz(3)
  finishedAt         DateTime?      @map("finished_at") @db.Timestamptz(3)
  updatedAt          DateTime       @map("updated_at") @db.Timestamptz(3)
  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task               Task           @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  toolCalls          AgentToolCall[]
  artifacts          Artifact[] @relation("ArtifactRun")
  confirmations      HumanConfirmation[]
  modelInvocation    ModelInvocation?

  @@unique([id, userId, projectId, taskId], map: "agent_runs_agent_run_id_user_id_project_id_task_id_key")
  @@map("agent_runs")
}

model ModelInvocation {
  id                String                @id @map("model_invocation_id")
  agentRunId        String                @unique @map("agent_run_id")
  initiatedByUserId String                @map("initiated_by_user_id")
  provider          String
  model             String
  status            ModelInvocationStatus
  inputText         String                @map("input_text")
  inputHash         String                @map("input_hash")
  outputText        String?               @map("output_text")
  providerResponseId String?              @map("provider_response_id")
  inputTokens       Int?                  @map("input_tokens")
  outputTokens      Int?                  @map("output_tokens")
  totalTokens       Int?                  @map("total_tokens")
  errorCode         String?               @map("error_code")
  idempotencyKey    String                @map("idempotency_key")
  requestFingerprint String               @map("request_fingerprint")
  createdAt         DateTime              @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?             @map("completed_at") @db.Timestamptz(3)
  agentRun          AgentRun              @relation(fields:[agentRunId], references:[id], onDelete: Restrict)
  initiatedByUser   User                  @relation(fields:[initiatedByUserId], references:[id], onDelete: Restrict)
  @@unique([initiatedByUserId, idempotencyKey], map:"model_invocations_user_idempotency_key")
  @@map("model_invocations")
}

model AgentDefinition {
  id String @id @map("agent_definition_id")
  organizationId String @map("organization_id")
  key String
  name String
  description String?
  status AgentDefinitionStatus
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions AgentVersion[]
  assignments AgentAssignment[]
  @@unique([organizationId, key], map: "agent_definitions_organization_id_key_key")
  @@unique([id, organizationId], map: "agent_definitions_agent_definition_id_organization_id_key")
  @@map("agent_definitions")
}
model AgentVersion {
  id String @id @map("agent_version_id")
  agentDefinitionId String @map("agent_definition_id")
  version Int
  runtimeProfile AgentRuntimeProfile @map("runtime_profile")
  status AgentVersionStatus
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  agentDefinition AgentDefinition @relation(fields: [agentDefinitionId], references: [id], onDelete: Restrict)
  @@unique([agentDefinitionId, version], map: "agent_versions_agent_definition_id_version_key")
  @@map("agent_versions")
}
model AgentAssignment {
  id String @id @map("agent_assignment_id")
  organizationId String @map("organization_id")
  agentDefinitionId String @map("agent_definition_id")
  scopeType AgentAssignmentScopeType @map("scope_type")
  scopeId String @map("scope_id")
  status AgentAssignmentStatus
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  definition AgentDefinition @relation(fields: [agentDefinitionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([organizationId, agentDefinitionId, scopeType, scopeId], map: "agent_assignments_tuple_key")
  @@map("agent_assignments")
}

model AgentToolCall {
  id          String              @id @map("agent_tool_call_id")
  agentRunId  String              @map("agent_run_id")
  sequence    Int
  name        String
  deviceId    String?             @map("device_id")
  request     Json
  status      AgentToolCallStatus
  receipt     Json?
  createdAt   DateTime            @map("created_at") @db.Timestamptz(3)
  completedAt DateTime?           @map("completed_at") @db.Timestamptz(3)
  agentRun    AgentRun            @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  artifacts   Artifact[]          @relation("ArtifactSourceToolCall")
  confirmation HumanConfirmation?

  @@unique([id, agentRunId], map: "agent_tool_calls_agent_tool_call_id_agent_run_id_key")
  @@unique([id, agentRunId, deviceId], map: "agent_tool_calls_agent_tool_call_id_agent_run_id_device_id_key")
  @@unique([agentRunId, sequence], map: "agent_tool_calls_agent_run_id_sequence_key")
  @@map("agent_tool_calls")
}

model HumanConfirmation {
  id          String                  @id @map("human_confirmation_id")
  agentRunId  String                  @map("agent_run_id")
  toolCallId  String                  @unique @map("tool_call_id")
  userId      String                  @map("user_id")
  projectId   String                  @map("project_id")
  taskId      String                  @map("task_id")
  deviceId    String                  @map("device_id")
  status      HumanConfirmationStatus
  createdAt   DateTime                @map("created_at") @db.Timestamptz(3)
  decidedAt   DateTime?               @map("decided_at") @db.Timestamptz(3)
  agentRun    AgentRun                @relation(fields: [agentRunId, userId, projectId, taskId], references: [id, userId, projectId, taskId], onDelete: Restrict)
  toolCall    AgentToolCall           @relation(fields: [toolCallId, agentRunId, deviceId], references: [id, agentRunId, deviceId], onDelete: Restrict)

  @@unique([toolCallId, agentRunId, deviceId], map: "human_confirmations_tool_call_id_agent_run_id_device_id_key")
  @@map("human_confirmations")
}

model Artifact {
  id               String              @id @map("artifact_id")
  projectId        String              @map("project_id")
  taskId           String              @map("task_id")
  agentRunId       String              @map("agent_run_id")
  sourceToolCallId String              @unique(map: "artifacts_source_tool_call_id_key") @map("source_tool_call_id")
  type             ArtifactType
  storageKind      ArtifactStorageKind @map("storage_kind")
  relativePath     String              @map("relative_path")
  size             Int
  encoding         String
  sha256           String
  version          Int
  createdByUserId  String              @map("created_by_user_id")
  createdAt        DateTime            @map("created_at") @db.Timestamptz(3)
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task             Task                @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  agentRun         AgentRun            @relation("ArtifactRun", fields: [agentRunId, createdByUserId, projectId, taskId], references: [id, userId, projectId, taskId], onDelete: Restrict)
  sourceToolCall   AgentToolCall       @relation("ArtifactSourceToolCall", fields: [sourceToolCallId, agentRunId], references: [id, agentRunId], onDelete: Restrict)
  resultArtifacts  ResultArtifact[]

  @@unique([id, taskId, projectId], map: "artifacts_artifact_id_task_id_project_id_key")
  @@map("artifacts")
}

model Result {
  id                 String       @id @map("result_id")
  projectId          String       @map("project_id")
  taskId             String       @map("task_id")
  createdByUserId    String       @map("created_by_user_id")
  submittedByUserId  String?      @map("submitted_by_user_id")
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(3)
  status             ResultStatus
  idempotencyKey     String       @db.VarChar(64) @map("idempotency_key")
  requestFingerprint String       @db.Char(64) @map("request_fingerprint")
  createdAt          DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @map("updated_at") @db.Timestamptz(3)
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task               Task         @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Restrict)
  createdBy          User         @relation("ResultCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  submittedBy        User?        @relation("ResultSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  artifacts          ResultArtifact[]
  reviews            Review[]

  @@unique([id, taskId, projectId], map: "results_result_id_task_id_project_id_key")
  @@unique([id, projectId], map: "results_result_id_project_id_key")
  @@unique([createdByUserId, taskId, idempotencyKey], map: "results_creator_task_idempotency_key_key")
  @@map("results")
}

model Review {
  id         String         @id @map("review_id")
  resultId   String         @unique(map: "reviews_result_id_key") @map("result_id")
  projectId  String         @map("project_id")
  reviewerId String         @map("reviewer_id")
  decision   ReviewDecision
  comment    String?
  reviewedAt DateTime       @map("reviewed_at") @db.Timestamptz(3)
  result     Result         @relation(fields: [resultId, projectId], references: [id, projectId], onDelete: Restrict)
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

model ResultArtifact {
  resultId   String   @map("result_id")
  artifactId String   @map("artifact_id")
  taskId     String   @map("task_id")
  projectId  String   @map("project_id")
  result     Result   @relation(fields: [resultId, taskId, projectId], references: [id, taskId, projectId], onDelete: Restrict)
  artifact   Artifact @relation(fields: [artifactId, taskId, projectId], references: [id, taskId, projectId], onDelete: Restrict)

  @@id([resultId, artifactId])
  @@map("result_artifacts")
}

model TaskAssignment {
  taskId        String        @id @map("task_id")
  projectId     String        @map("project_id")
  userId        String        @map("user_id")
  task          Task          @relation(fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  projectMember ProjectMember @relation(fields: [projectId, userId], references: [projectId, userId], onDelete: Restrict)

  @@unique([taskId, projectId], map: "task_assignments_task_id_project_id_key")
  @@map("task_assignments")
}

model TaskDependency {
  taskId          String @map("task_id")
  dependsOnTaskId String @map("depends_on_task_id")
  projectId       String @map("project_id")
  task            Task   @relation("TaskDependencies", fields: [taskId, projectId], references: [id, projectId], onDelete: Cascade)
  dependsOnTask   Task   @relation("TaskDependents", fields: [dependsOnTaskId, projectId], references: [id, projectId], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}
