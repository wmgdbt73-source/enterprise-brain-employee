# Local development defaults only. Do not add secrets to this file.
API_PORT=3000
ADMIN_ORIGIN=http://127.0.0.1:5174
# Development-only demo seed: pnpm db:seed:demo
# Local PostgreSQL 16 development database. Replace only in your uncommitted .env.
DATABASE_URL=postgresql://enterprise_brain:enterprise_brain@localhost:5432/enterprise_brain?schema=public
# Server-only Model Runtime configuration. Keep OPENAI_API_KEY in an uncommitted .env.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_OUTPUT_TOKENS=1000
